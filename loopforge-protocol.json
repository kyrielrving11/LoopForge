{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/loopforge-protocol.json",
  "title": "LoopForge Protocol",
  "description": "JSON Schema for the LoopForge loop-compile protocol. Defines the wire format for all 3 modes (loop_compile, feedback, review) and internal types. Language-agnostic — reference implementation in TypeScript.",
  "type": "object",
  "$defs": {
    "Mode": {
      "type": "string",
      "enum": [
        "loop_compile",
        "feedback"
      ],
      "description": "LoopForge-loop_compile — TypeScript protocol definitions.\n\nAll types exchanged between the Main Agent and LoopForge flow through\nthese interfaces. This is the contract layer — no implementation logic.\n\nv3.3: 41 types — 2 enums + 35 interfaces + 4 type aliases."
    },
    "AgentStatus": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "stalled"
      ]
    },
    "ExecutionFeedback": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "constraint_violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_fixes_needed": {
          "type": "string"
        }
      },
      "required": [
        "output",
        "success",
        "constraint_violations",
        "manual_fixes_needed"
      ]
    },
    "ExecutionEvidence": {
      "type": "object",
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_results": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_criteria_met": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria_remaining": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progress_estimate": {
          "type": "number"
        }
      },
      "required": [
        "files_changed",
        "success_criteria_met",
        "success_criteria_remaining",
        "progress_estimate"
      ],
      "description": "P4: Structured execution evidence reported by the agent after each round.\nGives LoopForge visibility into what actually happened — files changed,\ntest results, success criteria met, and a subjective progress estimate.\nEnables the compiler to cross-validate agent claims and compute real progress."
    },
    "CriterionRevision": {
      "type": "object",
      "properties": {
        "old": {
          "type": "string"
        },
        "new": {
          "type": "string"
        }
      },
      "required": [
        "old",
        "new"
      ],
      "description": "P5: A revision to a success criterion — the old form and the new form.\nThe agent proposes this when it discovers the original criterion was\nwrong, unrealistic, or needs refinement."
    },
    "RoundContract": {
      "type": "object",
      "properties": {
        "work_item": {
          "type": "string"
        },
        "done_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundary_reason": {
          "type": "string"
        }
      },
      "required": [
        "done_when",
        "verification_plan",
        "scope"
      ],
      "description": "v3.3: Round Contract. v3.4 semantics: the field on a submission is a\nPROPOSAL for the NEXT round — it becomes the ACTIVE contract (rendered\nas the Current Task and checked for execution conformance) only after\nthe declaring round commits, and stays active until a committed eval\nlists every done_when item in success_criteria_met (complete) or\nreports outcome=\"blocked\". While active it is restated unchanged each\nround; on completion or block, the next contract is declared instead.\nThe ACTIVE contract is machine-derived from committed rounds\n(round-contract.ts) — never read from last_round_result. Optional:\nabsent = no contract this round, all contract checks stay silent and\nrendering is identical to a contract-less round.\n\nEvery field is machine-checkable except boundary_reason (audit only):\n- done_when items are claimed satisfied by listing them in\n  execution_evidence.success_criteria_met (verified per-round claim\n  model); leaving them out while success is claimed is premature_boundary\n  against the ACTIVE contract.\n- verification_plan names must reference configured, enabled\n  evidence.commands (round_unverifiable otherwise).\n- scope lists the files/directories the round may touch; actual git\n  changes outside it trigger round_scope_drift against the ACTIVE\n  contract."
    },
    "SelfEvaluation": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "output_summary": {
          "type": "string"
        },
        "constraint_violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "should_continue": {
          "type": "boolean"
        },
        "discovered_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objective_refinement": {
          "type": "string"
        },
        "emerged_subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_evidence": {
          "$ref": "#/$defs/ExecutionEvidence"
        },
        "retracted_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revised_success_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CriterionRevision"
          }
        },
        "wrong_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compression_checkpoint": {
          "type": "boolean"
        },
        "checkpoint_label": {
          "type": "string"
        },
        "worker_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkerResult"
          }
        },
        "next_action": {
          "type": "string"
        },
        "completed_subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canceled_subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "gave_up"
              ]
            },
            {
              "type": "string",
              "enum": [
                "blocked"
              ]
            },
            {
              "type": "string",
              "enum": [
                "needs_human_input"
              ]
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/RoundOutcome"
        },
        "blocker": {
          "type": "string"
        },
        "retroactiveClaims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_change_reason": {
          "type": "string"
        },
        "drift_clarification": {
          "type": "string"
        },
        "prompt_requests": {
          "$ref": "#/$defs/PromptRequests"
        },
        "round_contract": {
          "$ref": "#/$defs/RoundContract"
        }
      },
      "required": [
        "success",
        "output_summary",
        "constraint_violations",
        "should_continue"
      ],
      "description": "Structured self-evaluation embedded in compiled prompts.\nThe agent outputs this after completing each round.\nEvery field is consumed by at least one downstream function.\n\nv1.4 (P0–P2): Three new optional fields enable cognitive evolution.\nv1.5 (P4–P5): Execution evidence, progress tracking, and self-correction."
    },
    "RoundOutcome": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "LoopProjection": {
      "type": "object",
      "properties": {
        "focus": {
          "type": [
            "string",
            "null"
          ]
        },
        "todo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegation": {
          "type": "string"
        },
        "handoff": {
          "type": "string"
        }
      },
      "required": [
        "todo",
        "delegation",
        "handoff"
      ],
      "description": "v2.12: Typed cognitive state projection — runtime-derived facts shipped\nwith advance/status outputs. All fields are derived, zero persistence.\nConsumers: advance output (main agent), status (human/tooling), resume\nhandoff. The runtime provides facts; the agent decides actions."
    },
    "GateActionDescriptor": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "workspace_write"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "production"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "credentials"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "data_migration"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "public_api"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "publish"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "payment"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "external_communication"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "network"
                ]
              }
            ]
          }
        },
        "reversibility": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "reversible"
              ]
            },
            {
              "type": "string",
              "enum": [
                "recoverable"
              ]
            },
            {
              "type": "string",
              "enum": [
                "irreversible"
              ]
            },
            {
              "type": "string",
              "enum": [
                "unknown"
              ]
            }
          ]
        },
        "authorization": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "agent_allowed"
              ]
            },
            {
              "type": "string",
              "enum": [
                "user_required"
              ]
            },
            {
              "type": "string",
              "enum": [
                "unknown"
              ]
            }
          ]
        }
      },
      "required": [
        "description",
        "scope",
        "effects",
        "reversibility",
        "authorization"
      ],
      "description": "v2.12: Structured high-risk action descriptor (internal — audit display\nand gate classification). The MCP surface uses a flat gate text instead."
    },
    "DerivedGate": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user"
              ]
            },
            {
              "type": "string",
              "enum": [
                "agent"
              ]
            }
          ]
        },
        "question": {
          "type": "string"
        },
        "blockedScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedWork": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "problem": {
          "type": "string"
        },
        "requiredEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedResolution": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "description": "v2.12: Classified gate — user gates need human authorization, agent\ngates are resolved by the agent submitting verifiable evidence."
    },
    "GateDecision": {
      "type": "object",
      "properties": {
        "gateId": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user"
              ]
            },
            {
              "type": "string",
              "enum": [
                "agent"
              ]
            }
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "decidedAt": {
          "type": "string"
        },
        "actionHash": {
          "type": "string"
        }
      },
      "required": [
        "gateId",
        "kind",
        "approved",
        "scope",
        "note",
        "decidedAt",
        "actionHash"
      ],
      "description": "v2.12: A persisted user decision for a gate. The actionHash binds the\napproval to the exact canonicalized action — an edited action changes\nthe hash, so stale approvals fail the gateId match automatically."
    },
    "PromptRequests": {
      "type": "object",
      "properties": {
        "emphasize": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expand": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "milestones"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "sub_goals"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "constraint_lifecycle"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "agent_trust"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "progress"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "loop_synthesis"
                ]
              }
            ]
          }
        },
        "confusion_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "v2.9: Model-expressed information needs for the next round.\nSubmitted via SelfEvaluation.prompt_requests, consumed by the\nCompiler when assembling the next prompt. Transient — each round's\nrequests apply to that round only."
    },
    "MilestoneSummary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "round_range": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "carried_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progress_at_boundary": {
          "type": "number"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "agent_declared"
              ]
            },
            {
              "type": "string",
              "enum": [
                "criteria_milestone"
              ]
            },
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          ]
        },
        "generated_at_round": {
          "type": "number"
        }
      },
      "required": [
        "label",
        "round_range",
        "outcome",
        "carried_constraints",
        "resolved_constraints",
        "progress_at_boundary",
        "kind",
        "generated_at_round"
      ],
      "description": "v2.1: Milestone summary — a phase-boundary snapshot that survives\nrolling-window eviction. Triggered by three signals in priority order:\n\n1. agent_declared    — compression_checkpoint === true (agent marks phase complete)\n2. criteria_milestone — new success_criteria_met detected (semantic dedup)\n3. auto              — safety net after N rounds without a milestone\n\nBuilt from raw round data in vault entries — no new persistent storage.\nRendered in L2 prompts and always written to the state file."
    },
