{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/loopforge-protocol.json",
  "title": "LoopForge Protocol",
  "description": "JSON Schema for the LoopForge loop-compile protocol. Defines the wire format for all 3 modes (loop_compile, feedback, review) and internal types. Language-agnostic — reference implementation in TypeScript.",
  "type": "object",
  "$defs": {
    "Mode": {
      "type": "string",
      "enum": [
        "loop_compile",
        "feedback"
      ],
      "description": "LoopForge-loop_compile — TypeScript protocol definitions.\r\n\r\nAll types exchanged between the Main Agent and LoopForge flow through\r\nthese interfaces. This is the contract layer — no implementation logic.\r\n\r\nv3.3: 41 types — 2 enums + 35 interfaces + 4 type aliases."
    },
    "AgentStatus": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "stalled"
      ]
    },
    "ExecutionFeedback": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "constraint_violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_fixes_needed": {
          "type": "string"
        }
      },
      "required": [
        "output",
        "success",
        "constraint_violations",
        "manual_fixes_needed"
      ]
    },
    "ExecutionEvidence": {
      "type": "object",
      "properties": {
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_results": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_criteria_met": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_criteria_remaining": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progress_estimate": {
          "type": "number"
        }
      },
      "required": [
        "files_changed",
        "success_criteria_met",
        "success_criteria_remaining",
        "progress_estimate"
      ],
      "description": "P4: Structured execution evidence reported by the agent after each round.\r\nGives LoopForge visibility into what actually happened — files changed,\r\ntest results, success criteria met, and a subjective progress estimate.\r\nEnables the compiler to cross-validate agent claims and compute real progress."
    },
    "CriterionRevision": {
      "type": "object",
      "properties": {
        "old": {
          "type": "string"
        },
        "new": {
          "type": "string"
        }
      },
      "required": [
        "old",
        "new"
      ],
      "description": "P5: A revision to a success criterion — the old form and the new form.\r\nThe agent proposes this when it discovers the original criterion was\r\nwrong, unrealistic, or needs refinement."
    },
    "RoundContract": {
      "type": "object",
      "properties": {
        "work_item": {
          "type": "string"
        },
        "done_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "done_when",
        "verification_plan",
        "scope"
      ],
      "description": "v3.3: Round Contract. v3.4 semantics: the field on a submission is a\r\nPROPOSAL for the NEXT round — it becomes the ACTIVE contract (rendered\r\nas the Current Task and checked for execution conformance) only after\r\nthe declaring round commits, and stays active until a committed eval\r\nlists every done_when item in success_criteria_met (complete) or\r\nreports outcome=\"blocked\". While active it is restated unchanged each\r\nround; on completion or block, the next contract is declared instead.\r\nThe ACTIVE contract is machine-derived from committed rounds\r\n(round-contract.ts) — never read from last_round_result. Optional:\r\nabsent = no contract this round, all contract checks stay silent and\r\nrendering is identical to a contract-less round.\r\n\r\nEvery field is machine-checkable:\r\n- done_when items are claimed satisfied by listing them in\r\n  execution_evidence.success_criteria_met (verified per-round claim\r\n  model); leaving them out while success is claimed is premature_boundary\r\n  against the ACTIVE contract.\r\n- verification_plan names must reference configured, enabled\r\n  evidence.commands (round_unverifiable otherwise).\r\n- scope lists the files/directories the round may touch; actual git\r\n  changes outside it trigger round_scope_drift against the ACTIVE\r\n  contract."
    },
    "SelfEvaluation": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "output_summary": {
          "type": "string"
        },
        "constraint_violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "should_continue": {
          "type": "boolean"
        },
        "discovered_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objective_refinement": {
          "type": "string"
        },
        "emerged_subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subgoal_updates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubGoalUpdate"
          }
        },
        "execution_evidence": {
          "$ref": "#/$defs/ExecutionEvidence"
        },
        "retracted_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revised_success_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CriterionRevision"
          }
        },
        "wrong_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compression_checkpoint": {
          "type": "boolean"
        },
        "checkpoint_label": {
          "type": "string"
        },
        "worker_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkerResult"
          }
        },
        "next_action": {
          "type": "string"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "gave_up"
              ]
            },
            {
              "type": "string",
              "enum": [
                "blocked"
              ]
            },
            {
              "type": "string",
              "enum": [
                "needs_human_input"
              ]
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/RoundOutcome"
        },
        "blocker": {
          "type": "string"
        },
        "retroactiveClaims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_change_reason": {
          "type": "string"
        },
        "gate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drift_clarification": {
          "type": "string"
        },
        "prompt_requests": {
          "$ref": "#/$defs/PromptRequests"
        },
        "round_contract": {
          "$ref": "#/$defs/RoundContract"
        }
      },
      "required": [
        "success",
        "output_summary",
        "constraint_violations",
        "should_continue"
      ],
      "description": "Structured self-evaluation submitted at the round boundary.\r\nThe agent outputs this after completing each round.\r\nEvery field is consumed by at least one downstream function.\r\n\r\nv1.4 (P0–P2): Three new optional fields enable cognitive evolution.\r\nv1.5 (P4–P5): Execution evidence, progress tracking, and self-correction."
    },
    "RoundOutcome": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "LoopProjection": {
      "type": "object",
      "properties": {
        "focus": {
          "type": [
            "string",
            "null"
          ]
        },
        "todo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegation": {
          "type": "string"
        },
        "handoff": {
          "type": "string"
        }
      },
      "required": [
        "todo",
        "delegation",
        "handoff"
      ],
      "description": "v2.12: Typed cognitive state projection — runtime-derived facts shipped\r\nwith advance/status outputs. All fields are derived, zero persistence.\r\nConsumers: advance output (main agent), status (human/tooling), resume\r\nhandoff. The runtime provides facts; the agent decides actions."
    },
    "GateActionDescriptor": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "workspace_write"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "production"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "credentials"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "data_migration"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "public_api"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "publish"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "payment"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "external_communication"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "network"
                ]
              }
            ]
          }
        },
        "reversibility": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "reversible"
              ]
            },
            {
              "type": "string",
              "enum": [
                "recoverable"
              ]
            },
            {
              "type": "string",
              "enum": [
                "irreversible"
              ]
            },
            {
              "type": "string",
              "enum": [
                "unknown"
              ]
            }
          ]
        },
        "authorization": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "agent_allowed"
              ]
            },
            {
              "type": "string",
              "enum": [
                "user_required"
              ]
            },
            {
              "type": "string",
              "enum": [
                "unknown"
              ]
            }
          ]
        }
      },
      "required": [
        "description",
        "scope",
        "effects",
        "reversibility",
        "authorization"
      ],
      "description": "v2.12: Structured high-risk action descriptor (internal — audit display\r\nand gate classification). The MCP surface uses a flat gate text instead."
    },
    "DerivedGate": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user"
              ]
            },
            {
              "type": "string",
              "enum": [
                "agent"
              ]
            }
          ]
        },
        "question": {
          "type": "string"
        },
        "blockedScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedWork": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "problem": {
          "type": "string"
        },
        "requiredEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedResolution": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "description": "v2.12: Classified gate — user gates need human authorization, agent\r\ngates are resolved by the agent submitting verifiable evidence."
    },
    "GateDecision": {
      "type": "object",
      "properties": {
        "gateId": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user"
              ]
            },
            {
              "type": "string",
              "enum": [
                "agent"
              ]
            }
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "decidedAt": {
          "type": "string"
        },
        "actionHash": {
          "type": "string"
        }
      },
      "required": [
        "gateId",
        "kind",
        "approved",
        "scope",
        "note",
        "decidedAt",
        "actionHash"
      ],
      "description": "v2.12: A persisted user decision for a gate. The actionHash binds the\r\napproval to the exact canonicalized action — an edited action changes\r\nthe hash, so stale approvals fail the gateId match automatically."
    },
    "PromptRequests": {
      "type": "object",
      "properties": {
        "emphasize": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confusion_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "v2.9: Model-expressed information needs for the next round.\r\nSubmitted via SelfEvaluation.prompt_requests, consumed by the\r\nCompiler when assembling the next prompt. Transient — each round's\r\nrequests apply to that round only."
    },
    "MilestoneSummary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "round_range": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "carried_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progress_at_boundary": {
          "type": "number"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "agent_declared"
              ]
            },
            {
              "type": "string",
              "enum": [
                "criteria_milestone"
              ]
            },
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          ]
        },
        "generated_at_round": {
          "type": "number"
        }
      },
      "required": [
        "label",
        "round_range",
        "outcome",
        "carried_constraints",
        "resolved_constraints",
        "progress_at_boundary",
        "kind",
        "generated_at_round"
      ],
      "description": "v2.1: Milestone summary — a phase-boundary snapshot that survives\r\nrolling-window eviction. Triggered by three signals in priority order:\r\n\r\n1. agent_declared    — compression_checkpoint === true (agent marks phase complete)\r\n2. criteria_milestone — new success_criteria_met detected (semantic dedup)\r\n3. auto              — safety net after N rounds without a milestone\r\n\r\nBuilt from raw round data in vault entries — no new persistent storage.\r\nRendered in L2 prompts and always written to the state file."
    },
    "WorkerResult": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "subAgentType": {
          "type": "string"
        },
        "subTask": {
          "type": "string"
        },
        "resultSummary": {
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "success"
              ]
            },
            {
              "type": "string",
              "enum": [
                "partial"
              ]
            },
            {
              "type": "string",
              "enum": [
                "failed"
              ]
            }
          ]
        },
        "discoveredConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "agentId",
        "subTask",
        "resultSummary",
        "outcome"
      ],
      "description": "A single sub-agent / Worker delegation result (v1.9 — multi-agent).\r\nv3.7.1: `outcome` is the single reported fact. `success` is deleted —\r\nentries without a valid outcome are dropped by the parser, never\r\nderived. The whole array is optional and informational: it buys no\r\nmachine verdict and an absent/empty array (no delegation this round)\r\nis always accepted."
    },
    "LoopForgeRequest": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionFeedback"
            },
            {
              "type": "null"
            }
          ]
        },
        "skill_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "task",
        "mode"
      ],
      "additionalProperties": true,
      "description": "Regex to extract a self-evaluation JSON block from agent output."
    },
    "LoopObjective": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at_round": {
          "type": "number"
        },
        "loop_id": {
          "type": "string"
        },
        "version": {
          "type": "number"
        },
        "refinement_history": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "objective",
        "success_criteria",
        "hard_constraints",
        "created_at_round",
        "loop_id"
      ]
    },
    "CriterionStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "met"
              ]
            },
            {
              "type": "string",
              "enum": [
                "remaining"
              ]
            },
            {
              "type": "string",
              "enum": [
                "unknown"
              ]
            }
          ]
        },
        "met_at_round": {
          "type": "number"
        },
        "related_subgoal_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "text",
        "status",
        "related_subgoal_ids"
      ],
      "description": "v3.2: Derived per-criterion status for the progress dashboard — the\r\n\"goal → criteria → evidence\" vertical view. Zero persistence: derived from\r\nvault entries each round (met/remaining reports + Jaccard sub-goal links)."
    },
    "Lesson": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "constraint_violation"
              ]
            },
            {
              "type": "string",
              "enum": [
                "verification_error"
              ]
            },
            {
              "type": "string",
              "enum": [
                "verification_warning"
              ]
            }
          ]
        },
        "count": {
          "type": "number"
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "text",
        "kind",
        "count",
        "rounds"
      ],
      "description": "v3.2: A deterministic \"lesson learned\" — a constraint or verification\r\ncheck that failed repeatedly across rounds. Rendered in the prompt to\r\nimmunize the agent against repeating the same mistakes. Zero persistence:\r\nderived from vault entries each round; presentation only — never feeds\r\nthe enforcement gate's decisions."
    },
    "LoopHealth": {
      "type": "object",
      "properties": {
        "goal_alignment": {
          "type": "number"
        },
        "constraint_integrity": {
          "type": "number"
        },
        "drift_detected": {
          "type": "boolean"
        },
        "strategy_stability": {
          "type": "boolean"
        },
        "task_continuity": {
          "type": "number"
        },
        "escalation_recommended": {
          "type": "string"
        }
      },
      "required": [
        "goal_alignment",
        "constraint_integrity",
        "drift_detected",
        "strategy_stability",
        "task_continuity",
        "escalation_recommended"
      ]
    },
    "RollingSummary": {
      "type": "object",
      "properties": {
        "key_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recurring_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rounds_sampled": {
          "type": "number"
        },
        "generated_at_round": {
          "type": "number"
        },
        "failed_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MilestoneSummary"
          }
        }
      },
      "required": [
        "key_outcomes",
        "recurring_issues",
        "rounds_sampled",
        "generated_at_round"
      ]
    },
    "SubGoalUpdate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "in_progress"
              ]
            },
            {
              "type": "string",
              "enum": [
                "done"
              ]
            },
            {
              "type": "string",
              "enum": [
                "blocked"
              ]
            },
            {
              "type": "string",
              "enum": [
                "canceled"
              ]
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "description": "v3.7.1: One explicit sub-goal status transition. The closed migration\r\nmatrix (loop-compiler.ts, single source) governs legality:\r\nin_progress from pending|blocked; done from pending|in_progress|blocked;\r\nblocked|canceled from pending|in_progress; blocked → canceled. done and\r\ncanceled are terminal — re-opening requires a NEW emerged_subtasks item."
    },
    "SubGoal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "pending"
              ]
            },
            {
              "type": "string",
              "enum": [
