              "enum": [
                "partial"
              ]
            },
            {
              "type": "string",
              "enum": [
                "failed"
              ]
            }
          ]
        },
        "discoveredConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "agentId",
        "subAgentType",
        "subTask",
        "resultSummary",
        "success"
      ],
      "description": "A single sub-agent / Worker delegation result (v1.9 — multi-agent)."
    },
