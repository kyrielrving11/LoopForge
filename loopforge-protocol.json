{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopforge.dev/loopforge-protocol.json",
  "title": "LoopForge Protocol",
  "description": "JSON Schema for the LoopForge loop-compile protocol. Defines the wire format for all 3 modes (loop_compile, feedback, review) and internal types. Language-agnostic — reference implementation in TypeScript.",
  "type": "object",
  "$defs": {
    "WorkflowPhase": {
      "type": "string",
      "enum": [
        "planning",
        "awaiting_approval",
        "executing",
        "auditing",
        "terminal"
      ]
    },
    "ApprovalPolicy": {
      "type": "string",
      "enum": [
        "risk_only",
        "every_revision"
      ]
    },
    "RequiredAction": {
      "type": "string",
      "enum": [
        "submit_plan",
        "approve_plan",
        "execute_prompt",
        "resubmit_round",
        "restore_workspace",
        "refine_plan",
        "execute_audit",
        "none"
      ]
    },
    "PlanRiskTag": {
      "type": "string",
      "enum": [
        "destructive_workspace",
        "data_migration",
        "production_change",
        "credentials_or_permissions",
        "external_side_effect",
        "public_api_break"
      ]
    },
    "PlanStepKind": {
      "type": "string",
      "enum": [
        "executable",
        "outline",
        "external_gate"
      ]
    },
    "PlanStepStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "active",
        "done",
        "blocked",
        "canceled"
      ]
    },
    "EvaluationStepStatus": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "in_progress"
      ]
    },
    "WorkflowReadiness": {
      "type": "string",
      "enum": [
        "planning",
        "awaiting_approval",
        "executing",
        "blocked",
        "awaiting_external_gate",
        "ready_for_audit",
        "auditing",
        "completed"
      ]
    },
    "RoundCheckReport": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "passed"
              ]
            },
            {
              "type": "string",
              "enum": [
                "failed"
              ]
            },
            {
              "type": "string",
              "enum": [
                "not_run"
              ]
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "counts": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ]
    },
    "RoundEvidenceClaim": {
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "targetId",
        "evidenceRefs"
      ]
    },
    "AgentEvidenceReport": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoundCheckReport"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoundEvidenceClaim"
          }
        },
        "noChangeReason": {
          "type": "string"
        }
      }
    },
    "RoundBlocker": {
      "type": "object",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "dependency"
              ]
            },
            {
              "type": "string",
              "enum": [
                "external"
              ]
            },
            {
              "type": "string",
              "enum": [
                "needs_human_input"
              ]
            },
            {
              "type": "string",
              "enum": [
                "plan_change"
              ]
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    },
    "RoundDiscoveries": {
      "type": "object",
      "properties": {
        "wrongAssumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emergedWork": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "newConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PlanChangeRequest": {
      "type": "object",
      "properties": {
        "timing": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "before_continue"
              ]
            },
            {
              "type": "string",
              "enum": [
                "next_boundary"
              ]
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "affectedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "timing",
        "reason",
        "affectedIds"
      ]
    },
    "RoundReportV1": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/EvaluationStepStatus"
        },
        "summary": {
          "type": "string"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/AgentEvidenceReport"
        },
        "blocker": {
          "$ref": "#/$defs/RoundBlocker"
        },
        "discoveries": {
          "$ref": "#/$defs/RoundDiscoveries"
        },
        "planChangeRequest": {
          "$ref": "#/$defs/PlanChangeRequest"
        },
        "delegations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkerResult"
          }
        },
        "contextRequest": {
          "$ref": "#/$defs/ContextRequest"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "description": "Compact v3 report authored by the external Agent."
    },
    "MaterialAdvancementRecord": {
      "type": "object",
      "properties": {
        "round": {
          "type": "number"
        },
        "stepId": {
          "type": [
            "string",
            "null"
          ]
        },
        "planVersion": {
          "type": [
            "number",
            "null"
          ]
        },
        "material": {
          "type": "boolean"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "round",
        "material",
        "signals"
      ]
    },
    "ExternalGateBlock": {
      "type": "object",
      "properties": {
        "stepId": {
          "type": "string"
        },
        "planVersion": {
          "type": "number"
        },
        "evidenceRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedAt": {
          "type": "string"
        }
      },
      "required": [
        "stepId",
        "planVersion",
        "evidenceRequirements",
        "blockedAt"
      ]
    },
    "GateResolution": {
      "type": "object",
      "properties": {
        "planVersion": {
          "type": "number"
        },
        "stepId": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidenceReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "planVersion",
        "stepId",
        "summary",
        "evidenceReferences"
      ]
    },
    "WorkflowProgress": {
      "type": "object",
      "properties": {
        "planVersion": {
          "type": [
            "number",
            "null"
          ]
        },
        "planSteps": {
          "type": "string"
        },
        "outlineRemaining": {
          "type": "number"
        },
        "successCriteria": {
          "type": "string"
        },
        "externalGates": {
          "type": "string"
        },
        "readiness": {
          "$ref": "#/$defs/WorkflowReadiness"
        }
      },
      "required": [
        "planSteps",
        "outlineRemaining",
        "successCriteria",
        "externalGates",
        "readiness"
      ]
    },
    "CapabilityPreflight": {
      "type": "object",
      "properties": {
        "serverVersion": {
          "type": "string"
        },
        "reportContract": {
          "type": "string",
          "enum": [
            "round_report_v1"
          ]
        },
        "toolCount": {
          "type": "number"
        },
        "workspaceBound": {
          "type": "boolean"
        },
        "storeWritable": {
          "type": "boolean"
        },
        "gitEvidence": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "available"
              ]
            },
            {
              "type": "string",
              "enum": [
                "disabled"
              ]
            },
            {
              "type": "string",
              "enum": [
                "unavailable"
              ]
            }
          ]
        },
        "commandEvidence": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "configured"
              ]
            },
            {
              "type": "string",
              "enum": [
                "blocked"
              ]
            },
            {
              "type": "string",
              "enum": [
                "disabled"
              ]
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "serverVersion",
        "reportContract",
        "toolCount",
        "workspaceBound",
        "storeWritable",
        "gitEvidence",
        "commandEvidence",
        "warnings"
      ]
    },
    "PlanStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PlanStepKind"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refinement": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "outline"
              ]
            },
            {
              "type": "string",
              "enum": [
                "executable"
              ]
            }
          ]
        },
        "riskTags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanRiskTag"
          }
        },
        "status": {
          "$ref": "#/$defs/PlanStepStatus"
        },
        "refinesStepId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "dependsOn",
        "scope",
        "successCriteria",
        "constraints",
        "acceptanceCriteria",
        "evidenceRequirements",
        "refinement",
        "riskTags",
        "status"
      ]
    },
    "StructuredPlan": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string"
        },
        "successCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanStep"
          }
        }
      },
      "required": [
        "objective",
        "successCriteria",
        "constraints",
        "steps"
      ]
    },
    "PlanApprovalRecord": {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "planVersion": {
          "type": "number"
        },
        "decision": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "approved"
              ]
            },
            {
              "type": "string",
              "enum": [
                "rejected"
              ]
            }
          ]
        },
        "decidedAt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "approvalId",
        "planVersion",
        "decision",
        "decidedAt",
        "reason"
      ]
    },
    "PlanRevisionRecord": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "baseVersion": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "changeSummary": {
          "type": "string"
        },
        "evidenceReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submittedAt": {
          "type": "string"
        },
        "effectiveRound": {
          "type": "number"
        },
        "plan": {
          "$ref": "#/$defs/StructuredPlan"
        },
        "refinementLinks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changeImpact": {
          "$ref": "#/$defs/PlanChangeImpact"
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "version",
        "reason",
        "changeSummary",
        "evidenceReferences",
        "submittedAt",
        "effectiveRound",
        "plan",
        "refinementLinks",
        "changeImpact",
        "changedPaths"
      ]
    },
    "WorkflowState": {
      "type": "object",
      "properties": {
        "phase": {
          "$ref": "#/$defs/WorkflowPhase"
        },
        "approvalPolicy": {
          "$ref": "#/$defs/ApprovalPolicy"
        },
        "planningProfile": {
          "$ref": "#/$defs/PlanningProfile"
        },
        "planVersion": {
          "type": [
            "number",
            "null"
          ]
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanRevisionRecord"
          }
        },
        "approvalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvalHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanApprovalRecord"
          }
        },
        "activeStepId": {
          "type": [
            "string",
            "null"
          ]
        },
        "planningPrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "planSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "baselineConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pendingPlanChange": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanChangeRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "queuedPlanChange": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanChangeRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "auditVerifiedCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockingGate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalGateBlock"
            },
            {
              "type": "null"
            }
          ]
        },
        "advancementHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialAdvancementRecord"
          }
        }
      },
      "required": [
        "phase",
        "approvalPolicy",
        "planningProfile",
        "revisions",
        "approvalHistory",
        "baselineConstraints",
        "auditVerifiedCriteria",
        "advancementHistory"
      ]
    },
    "WorkspaceRuntimeSummary": {
      "type": "object",
      "properties": {
        "serverVersion": {
          "type": "string"
        },
        "bindingStatus": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "unbound"
              ]
            },
            {
              "type": "string",
              "enum": [
                "bound"
              ]
            },
            {
              "type": "string",
              "enum": [
                "mismatch"
              ]
            }
          ]
        },
        "workspaceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspaceFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "storeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "storeRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "bindingSource": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "explicit"
              ]
            },
            {
              "type": "string",
              "enum": [
                "git_root"
              ]
            },
            {
              "type": "string",
              "enum": [
                "cwd_legacy"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "serverVersion",
        "bindingStatus"
      ],
      "description": "Process-level workspace/store identity used by the MCP runtime."
    },
    "WorkspaceBinding": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number"
        },
        "workspaceId": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        },
        "workspaceFingerprint": {
          "type": "string"
        },
        "storeId": {
          "type": "string"
        },
        "storeRoot": {
          "type": "string"
        },
        "previousStoreRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundAt": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "workspaceId",
        "workspaceRoot",
        "workspaceFingerprint",
        "storeId",
        "storeRoot",
        "previousStoreRoots",
        "boundAt"
      ]
    },
    "StoreResolutionDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "session_not_found"
              ]
            },
            {
              "type": "string",
              "enum": [
                "session_version_unsupported"
              ]
            },
            {
              "type": "string",
              "enum": [
                "workspace_mismatch"
              ]
            },
            {
              "type": "string",
              "enum": [
                "session_corrupt"
              ]
            },
            {
              "type": "string",
              "enum": [
                "store_incomplete"
              ]
            },
            {
              "type": "string",
              "enum": [
                "orphan_markdown"
              ]
            },
            {
              "type": "string",
              "enum": [
                "ambiguous_loop"
              ]
            },
            {
              "type": "string",
              "enum": [
                "store_unreadable"
              ]
            }
          ]
        },
        "current": {
          "$ref": "#/$defs/WorkspaceRuntimeSummary"
        },
        "searchedStores": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphanMarkdownPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendation": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "current",
        "searchedStores",
        "matches",
        "orphanMarkdownPaths",
        "warnings"
      ]
    },
    "ContextRequest": {
      "type": "object",
      "properties": {
        "emphasize": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confusion_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "One-shot context request applied only to the immediately following prompt."
    },
    "WorkerResult": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "subAgentType": {
          "type": "string"
        },
        "subTask": {
          "type": "string"
        },
        "resultSummary": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "discoveredConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "agentId",
        "subAgentType",
        "subTask",
        "resultSummary",
        "success"
      ]
    }
  }
}
