    },
    "SubGoal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "pending"
