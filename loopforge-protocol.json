      "description": "v3.2: Derived per-criterion status for the progress dashboard — the\n\"goal → criteria → evidence\" vertical view. Zero persistence: derived from\nvault entries each round (met/remaining reports + Jaccard sub-goal links)."
    },
    "Lesson": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
