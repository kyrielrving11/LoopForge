              "type": "null"
            }
          ]
        },
        "skill_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "task",
        "mode"
      ],
      "additionalProperties": true
    },
    "LoopObjective": {
      "type": "object",
      "properties": {
        "objective": {
