{
  "version": "10",
  "engine": {
    "stall_lookback_rounds": 3,
    "max_rounds": 200,
    "enforcement_escalation_enabled": true,
    "agent_recovery_enabled": true,
    "backtrack_enabled": true,
    "backtrack_max_depth": 3,
    "backtrack_preserve_discoveries": true,
    "unverified_claim_streak_limit": 3
  },
  "prompt": {
    "l0_max_chars": 5000,
    "l1_max_chars": 10000,
    "l2_max_chars": 18000
  },
  "backend": {
    "root_dir": ".loopforge"
  },
  "evolution": {
    "max_discovered_constraints_per_round": 5,
    "max_start_criteria": 12,
    "max_active_subgoals": 12
  },
  "state_file": {
    "enabled": true,
    "directory": ".loopforge/state"
  },
  "evidence": {
    "providers": [
      "git"
    ],
    "timeout_ms": 120000,
    "commands": []
  },
  "mcp": {
    "session_lease_ms": 30000,
    "session_lease_renew_interval_ms": 10000
  },
  "gate": {
    "enabled": false
  }
}
