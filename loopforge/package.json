{
  "name": "loopforge",
  "version": "3.0.0",
  "description": "State, constraint, plan-execution, and evidence governance for long-horizon AI coding tasks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./replay": {
      "import": "./dist/replay.js",
      "types": "./dist/replay.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    }
  },
  "bin": {
    "loopforge": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "skills",
    "loop_policy.json",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc && node dist/generate-schema.js",
    "generate-schema": "npm run clean && tsc && node dist/generate-schema.js",
    "test": "npm run clean && tsc && node dist/generate-schema.js && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:watch": "tsc && node --test --watch dist/tests/*.test.js",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyrielrving11/LoopForge.git"
  },
  "keywords": [
    "cognitive-state",
    "ai-agent",
    "durable-agent",
    "claude-code",
    "llm",
    "cognitive-stability",
    "constraint-management",
    "plan-execution",
    "evidence-governance",
    "mcp"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
